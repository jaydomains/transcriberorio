# transcriber — every environment variable the service reads.
#
# Copy to .env, fill in, and keep it out of version control. There are no real values in
# this file and there must never be any: it is the list, not the secrets.
#
# REQUIRED means Config.from_env() refuses to start without it. It reports every missing
# variable at once, never one at a time, so a first deploy is one round trip and not ten.
# Everything else shows its built-in default as the value.
#
# Every explanation is on its own '#' line ABOVE the variable it belongs to, and never after
# the value on the same line. systemd's EnvironmentFile= and docker's --env-file both keep
# everything after the '=' verbatim, so `POLL_INTERVAL_S=120  # seconds` sets the interval to
# the whole of "120  # seconds" and the service refuses to start. `transcriber setup` writes
# a .env in exactly this shape, so a file written by the tool and a file copied from here
# read the same to every reader there is.


# --- Microsoft Graph ---------------------------------------------------------------
# An app registration with application (not delegated) permissions on the drive.

# REQUIRED. Entra tenant id for the client-credentials token.
GRAPH_TENANT_ID=

# REQUIRED. The app registration's (client) id.
GRAPH_CLIENT_ID=

# REQUIRED. The app registration's client secret. Never logged.
GRAPH_CLIENT_SECRET=

# REQUIRED. Id or principal name of the OneDrive owner.
GRAPH_USER_ID=

# YYYY-MM-DD, the date on GRAPH_CLIENT_SECRET. Optional to the service and REQUIRED IN
# PRACTICE: it is the single most likely way this service dies. Without the date it runs
# perfectly for two years and then stops dead on a Tuesday morning with no prior warning of
# any kind. With it, the morning email starts counting down 45 days out, puts it in the
# subject line 14 days out, and tells the external monitor the morning is not fine.
GRAPH_SECRET_EXPIRES_ON=


# --- routes: one kind of recording, one folder in, one folder out ------------------
# A route is one watched folder and where its results go — phone calls, site meetings,
# WhatsApp voice notes. The service runs as many as you list here, each with its own place
# in the OneDrive change feed. Written by `transcriber setup` and `transcriber routes`;
# you should rarely need to edit these by hand.
#
# The variable stem is the short name in capitals with hyphens as underscores, so the route
# `site-meetings` reads ROUTE_SITE_MEETINGS_*.
#
# Rules the service refuses to start on, because each one loses or misfiles a recording:
#   * no route's OUTPUT may be any route's SOURCE — the service would read its own
#     transcripts back in as recordings and transcribe them again, over and over;
#   * two switched-on routes may not share a SOURCE — a recording belongs to one kind, and
#     the other route would move past it as though it had been handled;
#   * an ARCHIVE may not be any route's SOURCE or OUTPUT.
# Two routes MAY share an OUTPUT. Pooling several kinds into one transcripts folder is
# deliberate and supported. And no route's SOURCE may sit INSIDE another route's SOURCE:
# OneDrive reports a folder and everything under it, so the outer route would claim the
# inner one's recordings. The wizard and `transcriber routes` check that against the live
# drive while you pick the folders, since a folder id cannot show it on its own.

# Short names, comma separated: calls,site-meetings,whatsapp
# Lowercase letters, digits and hyphens. Set this and the three legacy folder variables
# below are ignored.
ROUTES=

# One block per name in ROUTES. This is the shape, with `calls` as the example:
# ROUTE_CALLS_LABEL=Phone calls   # What the morning email calls this kind.
# ROUTE_CALLS_SOURCE=01ABC...     # REQUIRED per route. driveItem id of the folder they arrive in.
# ROUTE_CALLS_OUTPUT=01DEF...     # REQUIRED per route. driveItem id the three .md outputs go to.
# ROUTE_CALLS_ARCHIVE=01GHI...    # Empty means this kind is never archived — it stays where it is.
# ROUTE_CALLS_ENGINE=             # Empty means the service default (TRANSCRIBE_ENGINE).
# ROUTE_CALLS_ENABLED=true        # false pauses the route: the folder stops being watched, and
#                                 # nothing else changes. Its ledger history is untouched.
# ROUTE_CALLS_REVIEWER=           # Who approves the passages held back from this folder — normally
#                                 # whoever records into it. REQUIRED on every switched-on route
#                                 # before GATE_MODE=on will start: left blank, everything held from
#                                 # this folder goes to the service owner instead, including a staff
#                                 # member's own health and personal circumstances.


# --- the single-folder shape, from before routes existed ---------------------------
# STILL SUPPORTED, and it will keep working untouched. A .env with these three and no
# ROUTES runs as exactly one route named `default` — same folders, same ledger, same
# behaviour. Setting ROUTES makes these three ignored; setting both says so at startup
# rather than quietly preferring one. They are REQUIRED only when ROUTES is empty.

# driveItem id of the recordings folder (/CALLS).
SOURCE_FOLDER_ID=

# driveItem id the three .md outputs are written to.
OUTPUT_FOLDER_ID=

# driveItem id aged recordings are moved to. Nothing is ever deleted.
ARCHIVE_FOLDER_ID=

# Optional, and shared by every route. Where the pieces of a half-written output set are moved
# aside to. Leave it empty and they are named in the error and replaced on the next attempt.
# Never point it at an archive folder — nothing looks in there.
ORPHAN_FOLDER_ID=


# --- transcription engine ----------------------------------------------------------

# REQUIRED. One of: openai, elevenlabs, azure.
TRANSCRIBE_ENGINE=

# Override the engine's default endpoint. Leave empty for the normal one.
ENGINE_BASE_URL=

# REQUIRED only when TRANSCRIBE_ENGINE=azure (e.g. the region your Speech resource is in).
AZURE_SPEECH_REGION=

# The engine's key lives under its OWN variable name, so switching engines cannot leave the
# previous engine's key silently in use. Set the one matching TRANSCRIBE_ENGINE.
# REQUIRED when TRANSCRIBE_ENGINE=openai. Also the fallback for ANALYSIS_API_KEY.
OPENAI_API_KEY=

# REQUIRED when TRANSCRIBE_ENGINE=elevenlabs.
ELEVENLABS_API_KEY=

# REQUIRED when TRANSCRIBE_ENGINE=azure.
AZURE_SPEECH_KEY=

# YYYY-MM-DD, if the transcription key expires. Empty means it does not, or that you would
# rather find out the hard way. The morning email counts this one down too.
ENGINE_KEY_EXPIRES_ON=


# --- the AI pass -------------------------------------------------------------------
# Two tiers: the cheap model routes every recording so nothing is skipped on a guess; the
# strong model reads the substantive ones. Neither ever decides anything.

# REQUIRED, unless OPENAI_API_KEY is set and is the same key.
ANALYSIS_API_KEY=

# openai | anthropic. Read by the analysis pass, NOT by Config.
ANALYSIS_PROVIDER=anthropic

# must agree with ANALYSIS_PROVIDER or startup refuses.
ANALYSIS_BASE_URL=https://api.anthropic.com

# the router — runs on EVERY recording, so nothing is skipped on a guess.
ANALYSIS_MODEL_CHEAP=claude-haiku-4-5

# runs only on substantive recordings.
ANALYSIS_MODEL_STRONG=claude-opus-5

# YYYY-MM-DD, if the analysis key expires. Same countdown in the morning email.
ANALYSIS_KEY_EXPIRES_ON=


# --- the 06:00 digest --------------------------------------------------------------
# Sent every day, good days included: a report that only arrives when something breaks is
# indistinguishable from a service that has died.

# REQUIRED. SMTP host for the morning digest.
SMTP_HOST=

# 465 uses implicit TLS; anything else uses STARTTLS.
SMTP_PORT=587

# REQUIRED. SMTP username.
SMTP_USER=

# REQUIRED. SMTP password. Never logged, never in the digest.
SMTP_PASSWORD=

# REQUIRED. Envelope sender for the digest.
SMTP_FROM=

# REQUIRED. Digest recipients, comma separated.
SMTP_TO=

# Issue STARTTLS before authenticating. Turn off only for a local relay.
SMTP_STARTTLS=true

# REQUIRED. Pinged only after the digest actually went out, so something outside notices
# silence.
HEARTBEAT_URL=


# --- the group view: several copies, one email about all of them --------------------
# Each person runs their own copy against their own drive, so each copy sees one person's
# recordings and nothing else. That is the right shape and it leaves one hole: when
# somebody's copy stops working, the only person told is the one person whose record does
# not suffer for it. These five settings close it, and all five are optional — one person
# running this alone gets no group section at all, rather than a group of one.
#
# What each copy writes into the shared folder is counts, a name and a timestamp. No
# recording names, no words from any recording, not one line of what anybody said.

# Whose copy this is, in the group view — a person's name as you want it to read in the
# email (James, Sipho), not a hostname. Without it this copy stays out of the group view.
INSTANCE_NAME=

# driveItem id of the folder every copy drops its daily status into, so one of them can
# report on all of them. One small file per copy per day and nothing else.
GROUP_FOLDER_ID=

# Id or principal name of whoever owns GROUP_FOLDER_ID. Empty means it is in this copy's own
# drive.
GROUP_DRIVE_USER_ID=

# Who receives the one consolidated email about the whole group, comma separated. Set this on
# the ADMIN's copy ONLY: whichever copy has it reads every status file and sends the group
# email, and the copies that do not have it simply write their status and stay quiet. Move it
# to a different copy and the job moves with it; put it on two and you get two group emails,
# which is the visible mistake rather than the silent one.
GROUP_ADMIN_TO=

# How long a copy may go without dropping a status file before the group email calls it
# silent rather than quiet.
GROUP_SILENT_AFTER_HOURS=36


# --- holding things back for approval ----------------------------------------------
# Some of what is said on a call should not go into the record until a person has said it
# may: a staff matter, somebody's health, an admission of our own liability, an identity
# number, anybody asking that something not be written down, and our own cost set against
# our own charge in one breath. Prices, supplier rates, invoices, defects and a named person
# doing their job all flow through as they always have — most recordings hold nothing at all,
# and that is the intended answer.
#
# IT SHIPS WATCHING AND HOLDING NOTHING. Leave GATE_MODE=shadow for a fortnight of ordinary
# work first. The morning email builds the measurement, and the two lines to read are "read
# by the model" — which says whether the number means anything — and "that is, per day",
# which is how many times a day somebody would have to tap yes or no. Switch it on against a
# real number, never an estimate: the estimates differed by a factor of twenty-five.
#
# Nothing here ever releases or discards a passage on a timer. Only a person answers one.

# off | shadow | on. Default shadow: reads every recording, records what it would have held,
# and holds nothing. `on` actually withholds. `off` does not read for it at all and the
# analysis pass is unchanged from before it existed.
GATE_MODE=shadow

# SQLite file the held words live in. Empty means beside LEDGER_PATH. It must NOT be inside
# WORK_DIR — that is cleared on a disk budget, and a held passage is the only copy of those
# words outside the recording. Back it up with the ledger.
GATE_HELD_STORE=

# https:// address of the page passages are approved on. REQUIRED before GATE_MODE=on will
# start — without it nothing could ever be released. Each person's own link is built from this
# and sent in their copy of the 06:00 email.
GATE_REVIEW_BASE_URL=
# Who reviews which folder's passages: ROUTE_<NAME>_REVIEWER, in the route block above.


# --- the review page ---------------------------------------------------------------
# Read by `transcriber review`, which serves the page GATE_REVIEW_BASE_URL points at.
# Only needed once you arm the gate; ops/transcriber-review.service sets them for you.

# Address the page listens on. Leave it on loopback and put TLS in front of it.
REVIEW_BIND=127.0.0.1

# Port the page listens on.
REVIEW_PORT=8443

# PEM certificate and private key, if the page terminates TLS itself rather than
# sitting behind a proxy. Both must be set, or neither — and with neither, the page
# refuses to bind anything except loopback.
REVIEW_CERTFILE=
REVIEW_KEYFILE=

# Seconds a reviewer has to take back a decision before it is acted on. Empty uses
# the built-in window.
REVIEW_UNDO_SECONDS=


# --- durable state -----------------------------------------------------------------

# REQUIRED. Path to the SQLite ledger. No default on purpose: two ledgers is the same as none.
LEDGER_PATH=

# Scratch directory for downloads. It holds the raw audio of confidential conversations while
# a recording is in flight, and the audio of a failed one for two days afterwards so that a
# person can listen to what went wrong — so it belongs on a real disk that survives a restart,
# never in /tmp, which on many systems is a memory-backed filesystem emptied on every reboot.
# This is the path the systemd unit and the container image both set.
WORK_DIR=/var/cache/transcriber

# How much scratch WORK_DIR may hold before the service stops starting new recordings. Nothing
# is dropped: the queue waits. 0 means no limit.
WORK_DIR_MAX_BYTES=4GiB

# How long the downloaded audio of a finished or failed recording is kept before it is cleared
# away. The recording itself in OneDrive is never touched.
WORK_DIR_KEEP_FINISHED_HOURS=48


# --- loop and timing ---------------------------------------------------------------

# Seconds between delta polls.
POLL_INTERVAL_S=120

# Seconds between the completeness check's two size reads.
SETTLE_INTERVAL_S=60

# How long a worker's claim survives. Must exceed SETTLE_INTERVAL_S.
LEASE_SECONDS=900

# Recordings processed at once. This is about the machine: disk, memory, ffprobe.
CONCURRENCY=2

# Transcriptions in flight at the provider at once, across every folder. This is about the
# API's limits, not the machine's.
ENGINE_MAX_CONCURRENT=3

# Transcription requests started per minute, across every folder. 0 means no per-minute limit;
# set it to the number your provider allows.
ENGINE_MAX_PER_MINUTE=0

# After this long, the morning email calls the queue stale rather than busy.
QUEUE_STALE_HOURS=24

# After this long, an unfinished recording is called FAILED rather than queued. Below it, a
# backlog reads as work in hand.
STUCK_AFTER_HOURS=6

# Failures before a recording is quarantined for a person.
MAX_ATTEMPTS=3

# Age at which a finished, output-confirmed recording is moved. Failures are never moved.
ARCHIVE_AGE_DAYS=60

# Local hour the digest is sent, 0-23.
DIGEST_HOUR=6

# Local hour of the nightly re-enumeration, 0-23.
SWEEP_HOUR=1

# Day of month the archive pass runs, 1-28 so it exists in February.
ARCHIVE_DAY_OF_MONTH=1

# IANA zone the scheduled jobs are read in.
TIMEZONE=Africa/Johannesburg


# --- what to call a recording that arrived without a name ---------------------------
# A site note you did not get to naming before it uploaded arrives as the voice recorder's
# own name — Voice 260806_162219.m4a — and stays that way. This works out what it should be
# called from the site spoken in it, and says so in the morning email.
#
# It only ever touches a file still carrying that exact "Voice <digits>_<digits>" name.
# Anything you named yourself — CJ.m4a, Morne Interview.m4a, BEACH COURT SITE WALK 270826 —
# is never touched, and neither is a call, which your phone already names.
#
# Two outcomes and no third: a name, or no name. NO NAME IS NOT A PROBLEM — the recording is
# transcribed and filed on time either way, nothing waits for you, and there is nothing to
# approve. It goes by what you say at the top — "this is a site walk of Beach Court, general
# inspection" — and where you did not say it, by which site the conversation is mostly about.
# It refuses unless the recording is longer than two minutes and the record already has a
# folder for that site. Most recordings are named by you and so are never considered at all.
#
# IT SHIPS WORKING IT OUT AND WRITING NOTHING. Leave NAMING_APPLY off for a few weeks. The
# morning email says what it would have called each one, and you can see whether you agree
# before a single title reaches the record. Nobody has measured how often it fires or how
# often it is right, so the first weeks are the measurement.
#
# Nothing in OneDrive is ever renamed — not the audio, not the transcript files. The name
# reaches the transcript's subject line and heading, which is what the record reads.

# Tell the transcription engine your job names before it listens, so it writes "Lonehill" and
# not "on loan". A name it never transcribed cannot be matched afterwards by anything. Needs
# NAMING_SITES_FILE; costs nothing without it.
ENGINE_SITE_NAMES=true

# Tell the record which jobs a recording names, and which job each proposed action belongs to.
# A site walk covers more than one job, and without this every line arrives filed under one of
# them. Scored with the record's own rules, and written only into the two sidecar files — never
# into the transcript, which is the file the record scores, so a guess here cannot become the
# record's own evidence next time round. Needs NAMING_SITES_FILE; costs nothing without it.
SITE_EVIDENCE=true

# Work out a name and report it in the morning email.
NAMING=true

# Write that name into the transcript. Off means report only, and nothing in the record
# changes. Turn it on once the names in the email have looked right for a few weeks.
NAMING_APPLY=false

# The site list, written by ops/build-site-book.py from the record's nightly build. Without it
# NOTHING is ever named — which is safe, and is what happens if you skip this.
NAMING_SITES_FILE=

# Shortest recording that may be named. Below this an engine's own repetitions on a pocket
# recording are indistinguishable from a site genuinely being named twice.
NAMING_MIN_SECONDS=120

# How much of the start counts as you saying what the recording is. A call taken a few minutes
# in falls outside it.
NAMING_OPENING_SECONDS=60


# --- what to expect in the audio ---------------------------------------------------
# Hints only. They make a misheard word less likely; they are never treated as facts about
# the recording.

# Expected languages, best first.
LANGUAGES=en-ZA,af-ZA

# Site and construction terms, comma separated. Names, sites, materials.
VOCABULARY=

# Path to a file of terms, one per line, merged with VOCABULARY.
VOCABULARY_FILE=


# --- http and logging --------------------------------------------------------------

# Socket timeout for one HTTP call. The analysis pass raises its own floor.
HTTP_TIMEOUT_S=60

# Set this to start with an http:// engine, analysis or heartbeat address. Without it
# those three are refused unless they begin with https://, because an API key and an
# unredacted transcript travel over them. Set it only for a mock on your own machine:
# the startup notice then says out loud what is going in the open.
ALLOW_PLAINTEXT_ENDPOINTS=

# Retries after 429/5xx before giving up loudly. Retry-After is always honoured.
MAX_RETRIES=5

# DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Set to "json" for one JSON object per line. Read by the logger, NOT by Config.
LOG_FORMAT=
