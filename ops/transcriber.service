# transcriber — systemd unit for running the service directly on a machine.
#
#   sudo useradd --system --home-dir /var/lib/transcriber --shell /usr/sbin/nologin transcriber
#   sudo mkdir -p /opt/transcriber /var/lib/transcriber /var/cache/transcriber /etc/transcriber
#   sudo cp -r src ops ARCHITECTURE.md README.md /opt/transcriber/
#   sudo cp .env /etc/transcriber/transcriber.env
#   sudo chown -R transcriber:transcriber /var/lib/transcriber /var/cache/transcriber
#   sudo chmod 700 /var/lib/transcriber /var/cache/transcriber
#   sudo chown root:transcriber /etc/transcriber/transcriber.env
#   sudo chmod 640 /etc/transcriber/transcriber.env      # it holds every credential
#   sudo cp ops/transcriber.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now transcriber
#
# Nothing above pip-installs anything, on purpose — every import is from Python's own
# standard library, so the install is a file copy. That leaves one small hole: the `transcriber`
# command the documentation keeps using does not exist on the machine, because a console script
# is something pip would have written. Two lines close it, and then every command in every
# document is copy-pasteable exactly as written:
#
#   sudo tee /usr/local/bin/transcriber >/dev/null <<'SH'
#   #!/bin/sh
#   exec env PYTHONPATH=/opt/transcriber/src python3 -m transcriber "$@"
#   SH
#   sudo chmod 755 /usr/local/bin/transcriber
#
# Then, and this is the step worth not skipping:
#   sudo -u transcriber PYTHONPATH=/opt/transcriber/src python3 -m transcriber selftest
#   sudo systemctl status transcriber
#   journalctl -u transcriber -f

[Unit]
Description=transcriber — voice notes from OneDrive into the site-memory record
Documentation=file:/opt/transcriber/README.md
# Wants=, not Requires=: a DNS blip at boot must not stop the service starting. It polls
# every two minutes and its own retries are what handle a network that is not up yet.
Wants=network-online.target
After=network-online.target

# Do not restart forever in a tight loop if something is badly wrong: five failures inside
# ten minutes stops the unit, which shows up as `failed` in `systemctl status` and is a
# state a person — or a monitor — can actually see.
#
# These belong in [Unit]. They were in [Service], where systemd 255 answers
# "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring." — so the
# interval silently fell back to the 10s default while the burst was still read. With
# RestartSec=30s the restarts are 30 seconds apart, so five could never land inside 10
# seconds and the limit could never trip: a service that could not start — a bad
# credential, a missing environment file — looped every 30 seconds forever, showing
# `activating (auto-restart)` rather than `failed`, which is the state nothing is watching
# for. Verified with `systemd-analyze verify` before and after.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=transcriber
Group=transcriber

WorkingDirectory=/opt/transcriber
Environment=PYTHONPATH=/opt/transcriber/src
Environment=PYTHONUNBUFFERED=1

# The two paths this unit actually provisions below, set here so that a deploy is correct
# without the operator having read ops/DEPLOY.md closely. They are before EnvironmentFile= on
# purpose: systemd applies these in file order, so anything the operator sets in the .env still
# wins — these are the defaults, not an override.
#
# WORK_DIR matters more than it looks. PrivateTmp=yes gives this service its own private /tmp,
# which is emptied every time the unit restarts; on many distributions the host's /tmp is a
# memory-backed filesystem as well. Pointing the scratch there would mean every restart
# re-downloads whatever was in flight, and the audio of a FAILED recording — deliberately kept
# for two days so that a person can listen to what went wrong — would be gone before anybody
# could. The container image sets the same two paths.
Environment=WORK_DIR=/var/cache/transcriber
Environment=LEDGER_PATH=/var/lib/transcriber/ledger.sqlite

EnvironmentFile=/etc/transcriber/transcriber.env

ExecStart=/usr/bin/python3 -m transcriber run

# SIGTERM stops new work being taken up, waits for whatever is mid-flight, and hands back
# every claim this worker holds — so a restart leaves the queue exactly as it found it
# instead of stranding recordings behind a lease that has to expire. 120s is longer than any
# single step but shorter than a hung engine call, after which SIGKILL is correct: the leases
# expire on their own, which is what they are for.
KillSignal=SIGTERM
TimeoutStopSec=120

# Restart on any exit, including a clean one. The service exits non-zero on a *service*
# fault — a rejected credential, an unusable configuration — and coming straight back up is
# right: it will fail identically, say so identically in the log, and the moment the
# credential is fixed it carries on. RestartSec spaces that out so a permanently broken
# credential is a line a minute rather than a busy loop.
Restart=always
RestartSec=30s
# The rate limit that stops a tight restart loop lives in [Unit] above; systemd moved
# those two keys out of [Service] in version 229 and ignores them here.

# --- what it may touch ---------------------------------------------------------------
# The ledger is the only proof a recording ever existed; the scratch directory holds the raw
# audio of confidential conversations while a recording is in flight. Both are the service's
# own and nothing else's.
StateDirectory=transcriber
StateDirectoryMode=0700
CacheDirectory=transcriber
CacheDirectoryMode=0700
ReadWritePaths=/var/lib/transcriber /var/cache/transcriber

# --- hardening -----------------------------------------------------------------------
# It reads files from OneDrive over HTTPS and writes two directories. It has no business
# doing anything else, and a service that runs unattended for years is exactly the one to
# fence in.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# 0077 so anything it creates is readable only by itself, whatever the ambient umask is.
UMask=0077

# --- logging -------------------------------------------------------------------------
# stdout to the journal. There is deliberately no file handler and no rotation in the
# service itself: whatever runs it decides where the log goes.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=transcriber

[Install]
WantedBy=multi-user.target
