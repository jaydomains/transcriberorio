# transcriber — every environment variable the service reads.
#
# Copy to .env, fill in, and keep it out of version control. There are no real values in
# this file and there must never be any: it is the list, not the secrets.
#
# REQUIRED means Config.from_env() refuses to start without it. It reports every missing
# variable at once, never one at a time, so a first deploy is one round trip and not ten.
# Everything else shows its built-in default as the value.


# --- Microsoft Graph ---------------------------------------------------------------
# An app registration with application (not delegated) permissions on the drive.

GRAPH_TENANT_ID=                  # REQUIRED. Entra tenant id for the client-credentials token.
GRAPH_CLIENT_ID=                  # REQUIRED. The app registration's (client) id.
GRAPH_CLIENT_SECRET=              # REQUIRED. The app registration's client secret. Never logged.
GRAPH_USER_ID=                    # REQUIRED. Id or principal name of the OneDrive owner.


# --- routes: one kind of recording, one folder in, one folder out ------------------
# A route is one watched folder and where its results go — phone calls, site meetings,
# WhatsApp voice notes. The service runs as many as you list here, each with its own place
# in the OneDrive change feed. Written by `transcriber setup` and `transcriber routes`;
# you should rarely need to edit these by hand.
#
# The variable stem is the short name in capitals with hyphens as underscores, so the route
# `site-meetings` reads ROUTE_SITE_MEETINGS_*.
#
# Rules the service refuses to start on, because each one loses or misfiles a recording:
#   * no route's OUTPUT may be any route's SOURCE — the service would read its own
#     transcripts back in as recordings and transcribe them again, over and over;
#   * two switched-on routes may not share a SOURCE — a recording belongs to one kind, and
#     the other route would move past it as though it had been handled;
#   * an ARCHIVE may not be any route's SOURCE or OUTPUT.
# Two routes MAY share an OUTPUT. Pooling several kinds into one transcripts folder is
# deliberate and supported. And no route's SOURCE may sit INSIDE another route's SOURCE:
# OneDrive reports a folder and everything under it, so the outer route would claim the
# inner one's recordings. The wizard and `transcriber routes` check that against the live
# drive while you pick the folders, since a folder id cannot show it on its own.

ROUTES=                           # Short names, comma separated: calls,site-meetings,whatsapp
                                  # Lowercase letters, digits and hyphens. Set this and the three
                                  # legacy folder variables below are ignored.

# One block per name in ROUTES. This is the shape, with `calls` as the example:
# ROUTE_CALLS_LABEL=Phone calls   # What the morning email calls this kind.
# ROUTE_CALLS_SOURCE=01ABC...     # REQUIRED per route. driveItem id of the folder they arrive in.
# ROUTE_CALLS_OUTPUT=01DEF...     # REQUIRED per route. driveItem id the three .md outputs go to.
# ROUTE_CALLS_ARCHIVE=01GHI...    # Empty means this kind is never archived — it stays where it is.
# ROUTE_CALLS_ENGINE=             # Empty means the service default (TRANSCRIBE_ENGINE).
# ROUTE_CALLS_ENABLED=true        # false pauses the route: the folder stops being watched, and
#                                 # nothing else changes. Its ledger history is untouched.
# ROUTE_CALLS_REVIEWER=           # Who approves the passages held back from this folder — normally
#                                 # whoever records into it. REQUIRED on every switched-on route
#                                 # before GATE_MODE=on will start: left blank, everything held from
#                                 # this folder goes to the service owner instead, including a staff
#                                 # member's own health and personal circumstances.


# --- the single-folder shape, from before routes existed ---------------------------
# STILL SUPPORTED, and it will keep working untouched. A .env with these three and no
# ROUTES runs as exactly one route named `default` — same folders, same ledger, same
# behaviour. Setting ROUTES makes these three ignored; setting both says so at startup
# rather than quietly preferring one. They are REQUIRED only when ROUTES is empty.

SOURCE_FOLDER_ID=                 # driveItem id of the recordings folder (/CALLS).
OUTPUT_FOLDER_ID=                 # driveItem id the three .md outputs are written to.
ARCHIVE_FOLDER_ID=                # driveItem id aged recordings are moved to. Nothing is ever deleted.

ORPHAN_FOLDER_ID=                 # Optional, and shared by every route. Where the pieces of a
                                  # half-written output set are moved aside to. Leave it empty and
                                  # they are named in the error and replaced on the next attempt.
                                  # Never point it at an archive folder — nothing looks in there.


# --- transcription engine ----------------------------------------------------------

TRANSCRIBE_ENGINE=                # REQUIRED. One of: openai, elevenlabs, azure.
ENGINE_BASE_URL=                  # Override the engine's default endpoint. Leave empty for the normal one.
AZURE_SPEECH_REGION=              # REQUIRED only when TRANSCRIBE_ENGINE=azure (e.g. the region your Speech resource is in).

# The engine's key lives under its OWN variable name, so switching engines cannot leave the
# previous engine's key silently in use. Set the one matching TRANSCRIBE_ENGINE.
OPENAI_API_KEY=                   # REQUIRED when TRANSCRIBE_ENGINE=openai. Also the fallback for ANALYSIS_API_KEY.
ELEVENLABS_API_KEY=               # REQUIRED when TRANSCRIBE_ENGINE=elevenlabs.
AZURE_SPEECH_KEY=                 # REQUIRED when TRANSCRIBE_ENGINE=azure.


# --- the AI pass -------------------------------------------------------------------
# Two tiers: the cheap model routes every recording so nothing is skipped on a guess; the
# strong model reads the substantive ones. Neither ever decides anything.

ANALYSIS_API_KEY=                 # REQUIRED, unless OPENAI_API_KEY is set and is the same key.
ANALYSIS_PROVIDER=anthropic          # openai | anthropic. Read by the analysis pass, NOT by Config.
ANALYSIS_BASE_URL=https://api.anthropic.com   # must agree with ANALYSIS_PROVIDER or startup refuses.
ANALYSIS_MODEL_CHEAP=claude-haiku-4-5   # the router — runs on EVERY recording, so nothing is skipped on a guess.
ANALYSIS_MODEL_STRONG=claude-opus-5     # runs only on substantive recordings.


# --- the 06:00 digest --------------------------------------------------------------
# Sent every day, good days included: a report that only arrives when something breaks is
# indistinguishable from a service that has died.

SMTP_HOST=                        # REQUIRED. SMTP host for the morning digest.
SMTP_PORT=587                     # 465 uses implicit TLS; anything else uses STARTTLS.
SMTP_USER=                        # REQUIRED. SMTP username.
SMTP_PASSWORD=                    # REQUIRED. SMTP password. Never logged, never in the digest.
SMTP_FROM=                        # REQUIRED. Envelope sender for the digest.
SMTP_TO=                          # REQUIRED. Digest recipients, comma separated.
SMTP_STARTTLS=true                # Issue STARTTLS before authenticating. Turn off only for a local relay.
HEARTBEAT_URL=                    # REQUIRED. Pinged only after the digest actually went out, so something outside notices silence.


# --- holding things back for approval ----------------------------------------------
# Some of what is said on a call should not go into the record until a person has said it
# may: a staff matter, somebody's health, an admission of our own liability, an identity
# number, anybody asking that something not be written down, and our own cost set against
# our own charge in one breath. Prices, supplier rates, invoices, defects and a named person
# doing their job all flow through as they always have — most recordings hold nothing at all,
# and that is the intended answer.
#
# IT SHIPS WATCHING AND HOLDING NOTHING. Leave GATE_MODE=shadow for a fortnight of ordinary
# work first. The morning email builds the measurement, and the two lines to read are "read
# by the model" — which says whether the number means anything — and "that is, per day",
# which is how many times a day somebody would have to tap yes or no. Switch it on against a
# real number, never an estimate: the estimates differed by a factor of twenty-five.
#
# Nothing here ever releases or discards a passage on a timer. Only a person answers one.

GATE_MODE=shadow                  # off | shadow | on. Default shadow: reads every recording, records what it
                                  # would have held, and holds nothing. `on` actually withholds. `off` does not
                                  # read for it at all and the analysis pass is unchanged from before it existed.
GATE_HELD_STORE=                  # SQLite file the held words live in. Empty means beside LEDGER_PATH. It must NOT
                                  # be inside WORK_DIR — that is cleared on a disk budget, and a held passage is the
                                  # only copy of those words outside the recording. Back it up with the ledger.
GATE_REVIEW_BASE_URL=             # https:// address of the page passages are approved on. REQUIRED before
                                  # GATE_MODE=on will start — without it nothing could ever be released. Each
                                  # person's own link is built from this and sent in their copy of the 06:00 email.
# Who reviews which folder's passages: ROUTE_<NAME>_REVIEWER, in the route block above.


# --- durable state -----------------------------------------------------------------

LEDGER_PATH=                      # REQUIRED. Path to the SQLite ledger. No default on purpose: two ledgers is the same as none.
WORK_DIR=/tmp/transcriber         # Scratch directory for downloads. Prefer a real disk over /tmp for a long backfill.
WORK_DIR_MAX_BYTES=4GiB           # How much scratch WORK_DIR may hold before the service stops starting new recordings. Nothing is dropped: the queue waits. 0 means no limit.
WORK_DIR_KEEP_FINISHED_HOURS=48   # How long the downloaded audio of a finished or failed recording is kept before it is cleared away. The recording itself in OneDrive is never touched.


# --- loop and timing ---------------------------------------------------------------

POLL_INTERVAL_S=120               # Seconds between delta polls.
SETTLE_INTERVAL_S=60              # Seconds between the completeness check's two size reads.
LEASE_SECONDS=900                 # How long a worker's claim survives. Must exceed SETTLE_INTERVAL_S.
CONCURRENCY=2                     # Recordings processed at once. This is about the machine: disk, memory, ffprobe.
ENGINE_MAX_CONCURRENT=3           # Transcriptions in flight at the provider at once, across every folder. This is about the API's limits, not the machine's.
ENGINE_MAX_PER_MINUTE=0           # Transcription requests started per minute, across every folder. 0 means no per-minute limit; set it to the number your provider allows.
QUEUE_STALE_HOURS=24              # After this long, the morning email calls the queue stale rather than busy.
STUCK_AFTER_HOURS=6               # After this long, an unfinished recording is called FAILED rather than queued. Below it, a backlog reads as work in hand.
MAX_ATTEMPTS=3                    # Failures before a recording is quarantined for a person.
ARCHIVE_AGE_DAYS=60               # Age at which a finished, output-confirmed recording is moved. Failures are never moved.
DIGEST_HOUR=6                     # Local hour the digest is sent, 0-23.
SWEEP_HOUR=1                      # Local hour of the nightly re-enumeration, 0-23.
ARCHIVE_DAY_OF_MONTH=1            # Day of month the archive pass runs, 1-28 so it exists in February.
TIMEZONE=Africa/Johannesburg      # IANA zone the scheduled jobs are read in.


# --- what to call a recording that arrived without a name ---------------------------
# A site note you did not get to naming before it uploaded arrives as the voice recorder's
# own name — Voice 260806_162219.m4a — and stays that way. This works out what it should be
# called from the site spoken in it, and says so in the morning email.
#
# It only ever touches a file still carrying that exact "Voice <digits>_<digits>" name.
# Anything you named yourself — CJ.m4a, Morne Interview.m4a, BEACH COURT SITE WALK 270826 —
# is never touched, and neither is a call, which your phone already names.
#
# Two outcomes and no third: a name, or no name. NO NAME IS NOT A PROBLEM — the recording is
# transcribed and filed on time either way, nothing waits for you, and there is nothing to
# approve. It refuses unless the site is spoken by name at least twice, spread right across
# the recording, the recording is longer than two minutes, and the record already has a
# folder for that site. Most recordings are named by you and so are never considered at all.
#
# IT SHIPS WORKING IT OUT AND WRITING NOTHING. Leave NAMING_APPLY off for a few weeks. The
# morning email says what it would have called each one, and you can see whether you agree
# before a single title reaches the record. Nobody has measured how often it fires or how
# often it is right, so the first weeks are the measurement.
#
# Nothing in OneDrive is ever renamed — not the audio, not the transcript files. The name
# reaches the transcript's subject line and heading, which is what the record reads.

NAMING=true                       # Work out a name and report it in the morning email.
NAMING_APPLY=false                # Write that name into the transcript. Off means report only,
                                  # and nothing in the record changes. Turn it on once the names
                                  # in the email have looked right for a few weeks.
NAMING_SITES_FILE=                # The site list, written by ops/build-site-book.py from the
                                  # record's nightly build. Without it NOTHING is ever named —
                                  # which is safe, and is what happens if you skip this.
NAMING_MIN_SECONDS=120            # Shortest recording that may be named. Below this an engine's
                                  # own repetitions on a pocket recording are indistinguishable
                                  # from a site genuinely being named twice.


# --- what to expect in the audio ---------------------------------------------------
# Hints only. They make a misheard word less likely; they are never treated as facts about
# the recording.

LANGUAGES=en-ZA,af-ZA             # Expected languages, best first.
VOCABULARY=                       # Site and construction terms, comma separated. Names, sites, materials.
VOCABULARY_FILE=                  # Path to a file of terms, one per line, merged with VOCABULARY.


# --- http and logging --------------------------------------------------------------

HTTP_TIMEOUT_S=60                 # Socket timeout for one HTTP call. The analysis pass raises its own floor.
MAX_RETRIES=5                     # Retries after 429/5xx before giving up loudly. Retry-After is always honoured.
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR.
LOG_FORMAT=                       # Set to "json" for one JSON object per line. Read by the logger, NOT by Config.
